# Salin berkas ini menjadi ".env" lalu sesuaikan bila perlu. Semua baris di
# bawah ini bersifat OPSIONAL — aplikasi akan berjalan dengan baik memakai
# nilai default yang aman jika file .env tidak dibuat sama sekali.

# --- Jaringan ---
# MINER_DASH_HOST=0.0.0.0
# MINER_DASH_PORT=8420

# Aktifkan HTTPS dengan sertifikat self-signed yang dibuat otomatis.
# Direkomendasikan jika dasbor ini dapat diakses oleh perangkat lain di
# jaringan Wi-Fi bersama, karena login & sesi akan terenkripsi.
# MINER_DASH_ENABLE_TLS=false

# --- Lokasi data ---
# Ke mana database SQLite, kunci sesi, dan sertifikat TLS disimpan.
# MINER_DASH_DATA_DIR=~/.miner-dashboard

# --- Polling perangkat ---
# MINER_DASH_POLL_INTERVAL=15
# MINER_DASH_DEVICE_TIMEOUT=4
# MINER_DASH_RETENTION_DAYS=30

# --- Keamanan jaringan ---
# Jangan aktifkan ini kecuali Anda benar-benar tahu risikonya: mengizinkan
# dasbor menghubungi alamat IP di luar jaringan privat Anda.
# MINER_DASH_ALLOW_PUBLIC_TARGETS=false

# --- Rate limiting ---
# MINER_DASH_LOGIN_ATTEMPTS=5
# MINER_DASH_LOGIN_WINDOW=60
# MINER_DASH_LOGIN_LOCKOUT=900
# MINER_DASH_API_RATE_LIMIT=120
# MINER_DASH_CONTROL_RATE_LIMIT=20

# --- Ambang aman kontrol suhu otomatis ---
# MINER_DASH_AUTOTUNE_HARD_CUTOFF_C=88
